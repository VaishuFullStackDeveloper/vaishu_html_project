SELECT c.category_name, COUNT(mi.item_id) AS item_count\
FROM categories c\
JOIN menu_items mi ON c.category_id = mi.category_id\
GROUP BY c.category_name\
ORDER BY item_count DESC\
LIMIT 2;\
