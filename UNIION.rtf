\fs24 \cf0 \strokec2 3.1. Items Not Available as Specials\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : List all menu items that are not part of any daily specials.\
\
SELECT item_name\
FROM menu_items\
\
EXCEPT\
\
SELECT (item->>'item_name')::text AS item_name\
FROM specials, jsonb_array_elements(special_items) item;\
\
\
\pard\pardeftab720\sa319\partightenfactor0

\f2\b \cf0 \strokec2 3.2. Ingredients Used in "Grilled Chicken Breast" But Not in "Caesar Salad"\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : Find ingredients used in "Grilled Chicken Breast" that are not used in "Caesar Salad".\
SELECT i.ingredient_name\
FROM ingredients i\
JOIN menu_item_ingredients mii ON i.ingredient_id = mii.ingredient_id\
JOIN menu_items mi ON mii.menu_item_id = mi.item_id\
WHERE mi.item_name = 'Grilled Chicken Breast'\
\
EXCEPT\
\
SELECT i.ingredient_name\
FROM ingredients i\
JOIN menu_item_ingredients mii ON i.ingredient_id = mii.ingredient_id\
JOIN menu_items mi ON mii.menu_item_id = mi.item_id\
WHERE mi.item_name = 'Caesar Salad';\
\
\pard\pardeftab720\sa319\partightenfactor0

\f2\b \cf0 \strokec2 3.3. Expensive Menu Items Except in "Beverages"\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : List menu items with a price greater than $15 except those in the "Beverages" category.\
SELECT item_name, price\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE mi.price > 15\
\
EXCEPT\
\
SELECT item_name, price\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE c.category_name = 'Beverages' AND mi.price > 15;\
