\cf0 1. Count Menu Items by Category with a Minimum Price Threshold  -  List the categories that have more than one menu item with an average price greater than $10.\
\
SELECT c.category_name, COUNT(mi.item_id) AS item_count, AVG(mi.price) AS avg_price\
FROM categories c\
JOIN menu_items mi ON c.category_id = mi.category_id\
GROUP BY c.category_name\
HAVING AVG(mi.price) > 10 AND COUNT(mi.item_id) > 1;\
\
\
2. Total Sales by Category with Minimum Total Sales - : List the categories with total sales greater than $1000.\
\
SELECT c.category_name, SUM(o.quantity * mi.price) AS total_sales\
FROM orders o\
JOIN menu_items mi ON o.item_id = mi.item_id\
JOIN categories c ON mi.category_id = c.category_id\
GROUP BY c.category_name\
HAVING SUM(o.quantity * mi.price) > 1000;\
\
\
3. Average Ingredient Usage per Menu Item - List the menu items that use more than 3 ingredients and have an average ingredient count per item greater than 2.\
\
\pard\pardeftab720\partightenfactor0
\cf0 SELECT mi.item_name, COUNT(mii.ingredient_id) AS ingredient_count\
FROM menu_items mi\
JOIN menu_item_ingredients mii ON mi.item_id = mii.menu_item_id\
GROUP BY mi.item_name\
HAVING COUNT(mii.ingredient_id) > 3;\
\
\
\pard\pardeftab720\sa280\partightenfactor0

\f2\b\fs28 \cf0 \strokec2 4. Categories with Expensive Items\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Query
\f1\b0 : List categories that have any menu items with a price greater than $15.\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 SELECT c.category_name, MAX(mi.price) AS max_price\
FROM categories c\
JOIN menu_items mi ON c.category_id = mi.category_id\
GROUP BY c.category_name\
HAVING MAX(mi.price) > 15;\
\
\pard\pardeftab720\partightenfactor0
\cf0 5. Menu Items with Low Sales Volume\
\
\pard\pardeftab720\partightenfactor0

\f2\b \cf0 \strokec2 Query
\f1\b0 \strokec2 : Find menu items that have generated less than $500 in total sales.\
SELECT mi.item_name, SUM(o.quantity * mi.price) AS total_sales\
FROM menu_items mi\
JOIN orders o ON mi.item_id = o.item_id\
GROUP BY mi.item_name\
HAVING SUM(o.quantity * mi.price) < 500;\
\
\
\pard\pardeftab720\sa280\partightenfactor0

\f2\b\fs28 \cf0 \strokec2 . 
\f3\fs30\fsmilli15210 \strokec2 UNION
