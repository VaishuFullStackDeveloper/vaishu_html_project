\fs24 \cf0 \strokec2 1. 1 Menu Items from Different Categories\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : List all items from the "Appetizers" and "Desserts" categories.\
\
SELECT item_name, price\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE c.category_name = 'Appetizers'\
UNION\
SELECT item_name, price\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE c.category_name = 'Desserts';\
\
\pard\pardeftab720\sa319\partightenfactor0

\f2\b \cf0 \strokec2 1.2. All Ingredients and Menu Items\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : List all distinct ingredient names and menu item names in one list.\
SELECT ingredient_name AS name\
FROM ingredients\
UNION\
SELECT item_name AS name\
FROM menu_items;\
\
\pard\pardeftab720\sa319\partightenfactor0

\f2\b \cf0 \strokec2 1.3 High-Priced Items from Different Categories\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : List menu items with a price greater than $15 from both "Main Course" and "Beverages"\
\
SELECT item_name, price\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE c.category_name = 'Main Course' AND mi.price > 15\
\
UNION\
\
SELECT item_name, price\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE c.category_name = 'Beverages' AND mi.price > 15;\
\
\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 2. 
\f4\fs26 \strokec2 INTERSECT
\f1\fs24 \strokec2  Queries\
\
\pard\pardeftab720\sa319\partightenfactor0

\f2\b \cf0 \strokec2 2.1. Items Available as Specials and on the Regular Menu\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : Find menu items that are both regular menu items and also appear as daily specials.\
\
SELECT item_name\
FROM menu_items\
\
INTERSECT\
\
SELECT (item->>'item_name')::text AS item_name\
FROM specials, jsonb_array_elements(special_items) item;\
\
\
\pard\pardeftab720\sa319\partightenfactor0

\f2\b \cf0 \strokec2 2.2. Common Ingredients in Specific Menu Items\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : Find common ingredients between "Caesar Salad" and "Grilled Chicken Breast".\
SELECT i.ingredient_name\
FROM ingredients i\
JOIN menu_item_ingredients mii ON i.ingredient_id = mii.ingredient_id\
JOIN menu_items mi ON mii.menu_item_id = mi.item_id\
WHERE mi.item_name = 'Caesar Salad'\
\
INTERSECT\
\
SELECT i.ingredient_name\
FROM ingredients i\
JOIN menu_item_ingredients mii ON i.ingredient_id = mii.ingredient_id\
JOIN menu_items mi ON mii.menu_item_id = mi.item_id\
WHERE mi.item_name = 'Grilled Chicken Breast';\
\
\pard\pardeftab720\sa319\partightenfactor0

\f2\b \cf0 \strokec2 2.3. Overlapping High-Priced Items in Different Categories\
\pard\pardeftab720\sa240\partightenfactor0
\cf0 \strokec2 Query
\f1\b0 : Find menu items that are priced above $15 and are common to both the "Main Course" and "Appetizers" categories.\
SELECT item_name\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE c.category_name = 'Main Course' AND mi.price > 15\
\
INTERSECT\
\
SELECT item_name\
FROM menu_items mi\
JOIN categories c ON mi.category_id = c.category_id\
WHERE c.category_name = 'Appetizers' AND mi.price > 15;\
\
\pard\pardeftab720\sa280\partightenfactor0

