-- Create the categories table\
CREATE TABLE categories (\
    category_id SERIAL PRIMARY KEY,\
    category_name VARCHAR(255) NOT NULL\
);\
\
-- Create the menu_items table with a foreign key to categories\
CREATE TABLE menu_items (\
    item_id SERIAL PRIMARY KEY,\
    item_name VARCHAR(255) NOT NULL,\
    category_id INT REFERENCES categories(category_id),\
    price DECIMAL(10, 2) NOT NULL,\
    description TEXT\
);\
\
-- Create the ingredients table\
CREATE TABLE ingredients (\
    ingredient_id SERIAL PRIMARY KEY,\
    ingredient_name VARCHAR(255) NOT NULL\
);\
\
-- Create the junction table for the many-to-many relationship between menu_items and ingredients\
CREATE TABLE menu_item_ingredients (\
    menu_item_id INT REFERENCES menu_items(item_id),\
    ingredient_id INT REFERENCES ingredients(ingredient_id),\
    PRIMARY KEY (menu_item_id, ingredient_id)\
);\
\
\
-- Create the specials table with a JSON field\
CREATE TABLE specials (\
    special_id SERIAL PRIMARY KEY,\
    special_date DATE NOT NULL,\
    special_items JSONB NOT NULL\
);\
\
