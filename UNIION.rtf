-- Insert 5,000 records into products_a\
DO $$\
BEGIN\
    FOR i IN 1..5000 LOOP\
        INSERT INTO products_a (product_name, category, price)\
        VALUES ('Product_' || i, 'Category_' || (i % 10 + 1), 10 + (i % 100));\
    END LOOP;\
END $$;\
\
-- Insert 5,000 records into products_b\
DO $$\
BEGIN\
    FOR i IN 1..5000 LOOP\
        INSERT INTO products_b (product_name, category, price)\
        VALUES ('Product_' || (i + 2500), 'Category_' || ((i + 5) % 10 + 1), 20 + (i % 100));\
    END LOOP;\
END $$;\
